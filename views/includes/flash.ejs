
<!-- //if the success are done then gives this alert -->

<% if(success && success.length){ %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3 mt-1" role="alert">
    <%= success %>
   <!-- //dismissible or btn use to cut that msg or popup of success -->
    <button type="button" 
       class="btn-close"
       data-bs-dismiss="alert" 
       aria-label="Close">
    </button>
</div>
<% } %>

<!-- ------------------------------------------------------------------ -->

<!-- //ERROR -->
<!-- //if the failure/error then gives this alert -->

<% if(error && error.length){ %>
<div class="alert alert-danger alert-dismissible fade show col-6 offset-3 mt-1" role="alert">
    <%= error %>
   <!-- //dismissible or btn use to cut that msg or popup of success -->
    <button type="button" 
       class="btn-close"
       data-bs-dismiss="alert" 
       aria-label="Close">
    </button>
</div>
<% } %>
